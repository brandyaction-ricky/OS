{
  "schemaVersion": "1.0",
  "id": "youtube-production-v1",
  "name": "유튜브 제작·업로드 파이프라인",
  "version": "1.0",
  "processId": "longform",
  "entryStep": "edit",
  "exitStep": "metrics",
  "description": "브랜디액션 실제 후반작업 8단계를 OS 안에서 반자동화하고 최종 렌더, YouTube 게시, 성과 회수까지 연결한다.",
  "sourceNote": "PDF의 후반작업 8개 공정은 실행 가능한 9개 단계로 분해했다. 입력 검증과 최종 렌더·제목/썸네일·실제 게시·성과 회수는 OS가 보완한 단계다.",
  "phases": [
    { "id": "prepare", "label": "입력·기획", "order": 1 },
    { "id": "visual", "label": "시각 제작", "order": 2 },
    { "id": "assemble", "label": "편집 조립", "order": 3 },
    { "id": "publish", "label": "검수·게시", "order": 4 },
    { "id": "learn", "label": "성과 회수", "order": 5 }
  ],
  "stages": [
    {
      "id": "input_intake",
      "order": 1,
      "phase": "prepare",
      "label": "입력 접수·검증",
