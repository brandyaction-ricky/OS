      "ui": {
        "mode": "publish_package", "eyebrow": "PUBLISH PACKAGE", "helper": "AI는 초안을 만들고 사람은 실제 게시될 제목과 CTA만 확인합니다.", "primaryAction": "게시 문안 생성",
        "fields": [
          { "key": "playlist", "label": "재생목록", "type": "text", "default": "브랜디액션" },
          { "key": "longformTitle", "label": "롱폼 제목 확정", "type": "text", "default": "" },
          { "key": "shortsTitleRule", "label": "숏폼 제목 규칙", "type": "text", "default": "핵심 메시지 + #shorts" },
          { "key": "descriptionNote", "label": "설명문 추가 메모", "type": "textarea", "default": "" }
