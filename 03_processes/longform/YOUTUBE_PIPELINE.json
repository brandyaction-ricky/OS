          { "key": "burnCaptions", "label": "자막 합성", "type": "checkbox", "default": true },
          { "key": "normalizeAudio", "label": "음량 정규화", "type": "checkbox", "default": true }
        ]
      }
    },
    {
      "id": "publish_package", "order": 7, "phase": "publish", "label": "업로드 문안·설정", "shortLabel": "게시 준비",
