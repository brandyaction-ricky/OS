      "humanGate": true,
      "parallelGroup": "text"
    },
    {
      "id": "photo_generation",
      "order": 5,
      "phase": "visual",
      "label": "사진 생성·선택",
      "shortLabel": "사진 생성",
      "source": "pdf",
      "owner": "ricky",
      "provider": "gemini_image",
