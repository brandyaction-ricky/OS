    "steps": [
      { "id": "subtitle_review", "order": 1, "label": "자막 검수·정리", "tool": "SRT", "description": "오탈자·띄어쓰기·인명·용어를 맥락과 검색으로 자기검수하고 문장 단위로 정돈한다. 빈 컷·타이밍 공백·앞뒤 여백을 제거한다.", "output": "정리된 SRT" },
