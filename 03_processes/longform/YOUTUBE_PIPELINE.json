      "ui": {
        "mode": "youtube_publish", "eyebrow": "YOUTUBE DELIVERY", "helper": "업로드 대상과 공개 설정을 마지막으로 확인한 뒤 실행합니다.", "primaryAction": "업로드 설정 검토",
        "fields": [
          { "key": "uploadLongform", "label": "롱폼 업로드", "type": "checkbox", "default": true },
          { "key": "uploadShorts", "label": "숏폼 업로드", "type": "checkbox", "default": true }
        ]
      }
