      { "id": "media_processing", "order": 6, "label": "미디어 처리", "tool": "ffmpeg", "description": "원본 음성은 무거운 보정을 하지 않고 음악은 인트로·아웃트로에 페이드한다. 화자는 원본 영상을 우하단에 축소 배치한다.", "output": "음악 WAV + 화자 배치" },
      { "id": "xml_assembly", "order": 7, "label": "XML 조립", "tool": "30fps · 단일 파일", "description": "V1 덱·엔딩, V2 화자, V3 캡처, A1 음성, A2 음악을 하나의 Premiere 편집 시퀀스로 조립한다.", "output": "최종 XML (Premiere 임포트)" },
      { "id": "youtube_assets", "order": 8, "label": "유튜브 자산", "tool": "복붙용", "description": "스크립트를 기준으로 해시태그·고정댓글·타임라인·설명문·인용·출처·히든태그를 생성한다.", "output": "업로드자산.txt" }
