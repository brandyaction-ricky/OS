  "originalProcess": {
    "sourceId": "brandyaction-production-process-pdf-20260821",
    "title": "브랜디액션 영상 제작 공정",
    "subtitle": "컷편집 MP4와 SRT를 받아 Premiere용 최종 XML과 YouTube 자산까지 만드는 후반작업 정본",
    "inputs": ["컷편집된 영상 MP4", "추출한 자막 SRT"],
    "outputs": ["최종 XML", "유튜브 자산 5종", "사진 프롬프트"],
    "steps": [
      { "id": "subtitle_review", "order": 1, "label": "자막 검수·정리", "tool": "SRT", "description": "오탈자·띄어쓰기·인명·용어를 맥락과 검색으로 자기검수하고 문장 단위로 정돈한다. 빈 컷·타이밍 공백·앞뒤 여백을 제거한다.", "output": "정리된 SRT" },
      { "id": "summary_deck", "order": 2, "label": "요약 덱 저술", "tool": "PPT ≠ 자막", "description": "자막을 옮기지 않고 문단의 핵심을 요약·대조·도식으로 압축한다. 6챕터, 상단 게이지바, 대사 타이밍에 맞춰 저술한다.", "output": "슬라이드 배열 + 타이밍 큐" },
      { "id": "photo_prompts", "order": 3, "label": "사진 프롬프트", "tool": "제작 전 확인", "description": "오프닝·지루한 지점·예시 지점에 사진 슬롯을 잡는다. 단색 레드 배경·피사체 하나를 기본으로 하고 인물이면 한국인을 명시한다.", "output": "프롬프트 목록 (prompts.md)" },
      { "id": "render_insert", "order": 4, "label": "렌더 + 사진 삽입", "tool": "headless Chrome", "description": "HTML 슬라이드를 1920×1080 PNG로 렌더한다. 사진은 풀화면과 상단 게이지만 사용하고 움직이는 그림 효과는 사진 레이어에만 적용한다.", "output": "슬라이드 PNG + 사진·게이지 레이어" },
      { "id": "capture_cards", "order": 5, "label": "캡처카드", "tool": "엔딩", "description": "‘고정댓글에서 진단 확인’ 카드 3버전과 0.5초 깜빡임, 끝 모자이크 1장을 항상 만든다.", "output": "s301 / s302 / s303" },
      { "id": "media_processing", "order": 6, "label": "미디어 처리", "tool": "ffmpeg", "description": "원본 음성은 무거운 보정을 하지 않고 음악은 인트로·아웃트로에 페이드한다. 화자는 원본 영상을 우하단에 축소 배치한다.", "output": "음악 WAV + 화자 배치" },
      { "id": "xml_assembly", "order": 7, "label": "XML 조립", "tool": "30fps · 단일 파일", "description": "V1 덱·엔딩, V2 화자, V3 캡처, A1 음성, A2 음악을 하나의 Premiere 편집 시퀀스로 조립한다.", "output": "최종 XML (Premiere 임포트)" },
      { "id": "youtube_assets", "order": 8, "label": "유튜브 자산", "tool": "복붙용", "description": "스크립트를 기준으로 해시태그·고정댓글·타임라인·설명문·인용·출처·히든태그를 생성한다.", "output": "업로드자산.txt" }
    ],
    "absoluteRules": [
      "PPT는 자막이 아니라 핵심 요약이다.",
      "인물은 사진으로, 개념은 글로 설명한다.",
      "움직이는 그림 효과는 사진에만 적용하고 게이지바와 레이어를 분리한다.",
      "용어·인명·사실은 맥락과 검색으로 자기검수한다.",
      "오디오에는 samplerate를 선언한다.",
      "원본 음성은 무겁게 보정하지 않는다.",
      "음악은 인트로·아웃트로 타임라인에 항상 둔다.",
      "원형 화자는 Premiere 타원 마스크로 처리한다.",
      "인물 사진 프롬프트에는 한국인을 명시한다.",
      "사진이 오기 전에는 완료 처리하지 않는다.",
      "애매하면 넘겨짚지 말고 반드시 질문한다."
    ]
  },
