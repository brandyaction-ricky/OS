      "ui": { "mode": "metrics", "eyebrow": "PERFORMANCE LOOP", "helper": "성과는 자동 수집하고 다음 콘텐츠 Wiki에 재사용할 인사이트만 남깁니다.", "primaryAction": "최신 성과 수집" }
