      "source": "os_extension",
      "owner": "jay",
      "provider": "human",
      "automationLevel": "반자동",
      "description": "컷편집 MP4와 원본 SRT가 모두 준비됐는지 확인하고 재생·타임코드·파일 연결 상태를 검증합니다.",
      "dependsOn": [],
      "inputKeys": ["source_video", "source_srt"],
      "outputs": ["validated_input_package"],
      "qualityChecks": ["MP4 재생 가능", "SRT 파싱 가능", "영상 길이와 마지막 자막 타임코드 일치"],
      "humanGate": false,
      "parallelGroup": null
    },
    {
      "id": "subtitle_cleanup",
      "order": 2,
      "phase": "prepare",
      "label": "자막 검수·정리",
