      "ui": { "mode": "master_upload", "eyebrow": "MASTER HANDOFF", "helper": "대용량 파일은 GitHub나 Vercel을 거치지 않고 저장소로 바로 전송됩니다.", "primaryAction": "완료본 등록" }
    },
    {
      "id": "master_validation", "order": 4, "phase": "handoff", "label": "완료본 자동 검증", "shortLabel": "완료본 검증",
