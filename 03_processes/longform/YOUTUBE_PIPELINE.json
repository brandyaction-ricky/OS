          { "key": "platform", "label": "배포 채널", "type": "select", "default": "youtube_shorts", "options": ["youtube_shorts", "instagram_reels", "both"] },
          { "key": "captionStyle", "label": "자막 스타일", "type": "select", "default": "brand_default", "options": ["brand_default", "keyword_emphasis", "minimal"] },
          { "key": "cta", "label": "마지막 CTA", "type": "text", "default": "고정댓글에서 진단 확인" },
          { "key": "exclude", "label": "제외할 구간·주제", "type": "textarea", "default": "" }
        ]
      }
