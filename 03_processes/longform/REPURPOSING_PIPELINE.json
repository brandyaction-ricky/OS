{
  "schemaVersion": "1.0",
  "id": "multichannel-repurposing-v1",
  "name": "멀티채널 콘텐츠 확장",
  "version": "1.0",
  "trigger": { "youtubeStages": ["master_validation", "youtube_assets"], "mode": "all_completed" },
  "defaults": {
    "shortsCount": 3,
    "shortDestinations": ["youtube_shorts", "instagram_reels"],
    "carouselCount": 1,
    "carouselSlides": 9,
    "threadsCount": 3,
    "threadsMix": { "single": 2, "thread": 1 },
    "approvalMode": "channel_preview_then_schedule",
    "schedule": [
      { "day": 0, "channel": "youtube", "label": "YouTube 롱폼" },
      { "day": 1, "channel": "shorts_reels", "item": 1, "label": "숏츠 1 + Reels 1" },
      { "day": 2, "channel": "instagram_carousel", "item": 1, "label": "Instagram 카드뉴스" },
      { "day": 3, "channel": "threads", "item": 1, "label": "Threads 단문 1" },
      { "day": 4, "channel": "shorts_reels", "item": 2, "label": "숏츠 2 + Reels 2" },
      { "day": 5, "channel": "threads", "item": 2, "label": "Threads 연속형" },
      { "day": 7, "channel": "shorts_reels", "item": 3, "label": "숏츠 3 + Reels 3" },
      { "day": 8, "channel": "threads", "item": 3, "label": "Threads 단문 2" }
    ]
  },
  "phases": [
    { "id": "core", "label": "공통 정본", "order": 1 },
    { "id": "shorts", "label": "Shorts + Reels", "order": 2 },
    { "id": "carousel", "label": "Instagram 카드뉴스", "order": 3 },
    { "id": "threads", "label": "Threads", "order": 4 },
    { "id": "learning", "label": "성과·학습", "order": 5 }
  ],
  "stages": [
    { "id": "content_dna", "order": 1, "phase": "core", "label": "Content DNA 생성", "provider": "openai", "dependsOn": [], "outputs": ["CONTENT_DNA.md"], "humanGate": false, "description": "최종 SRT·대본·제목·Wiki에서 핵심 약속, 주장, 근거, 훅, CTA와 위험 표현을 정본화합니다." },
    { "id": "atom_extract", "order": 2, "phase": "core", "label": "Atom 추출·채널 배정", "provider": "openai", "dependsOn": ["content_dna"], "outputs": ["ATOM_MANIFEST.json"], "humanGate": true, "description": "원본 타임코드와 근거를 유지한 재사용 단위를 추출하고 채널별 관점을 배정합니다." },
    { "id": "shorts_plan", "order": 3, "phase": "shorts", "label": "숏츠 3개 구간 기획", "provider": "openai", "dependsOn": ["atom_extract"], "outputs": ["SHORTS_PLAN.md"], "humanGate": true, "description": "서로 다른 훅을 가진 3개 구간과 자막·CTA를 설계합니다." },
    { "id": "shorts_render", "order": 4, "phase": "shorts", "label": "9:16 자동 렌더", "provider": "render_worker", "dependsOn": ["shorts_plan"], "outputs": ["shorts_manifest"], "humanGate": false, "description": "FFmpeg Worker가 9:16 리프레임·자막·CTA를 적용합니다." },
    { "id": "shorts_approve", "order": 5, "phase": "shorts", "label": "숏츠·Reels 미리보기", "provider": "human", "dependsOn": ["shorts_render"], "outputs": ["approved_shorts"], "humanGate": false, "description": "3개 영상을 확인하고 개별 제외·수정·예약을 확정합니다." },
    { "id": "shorts_publish", "order": 6, "phase": "shorts", "label": "Shorts·Reels 동시 발행", "provider": "social_publish_worker", "dependsOn": ["shorts_approve"], "outputs": ["shorts_publish_receipts"], "humanGate": false, "description": "각 영상의 채널별 문안을 적용해 YouTube Shorts와 Instagram Reels에 동시 발행합니다." },
    { "id": "carousel_plan", "order": 7, "phase": "carousel", "label": "카드뉴스 9장 기획", "provider": "openai", "dependsOn": ["atom_extract"], "outputs": ["CAROUSEL_PLAN.md"], "humanGate": true, "description": "표지 훅부터 CTA까지 9장 서사와 시각화 지시를 만듭니다." },
    { "id": "carousel_render", "order": 8, "phase": "carousel", "label": "디자인 자동 렌더", "provider": "design_worker", "dependsOn": ["carousel_plan"], "outputs": ["carousel_manifest"], "humanGate": false, "description": "브랜디액션 디자인 시스템으로 1080×1350 카드 이미지를 렌더합니다." },
    { "id": "carousel_approve", "order": 9, "phase": "carousel", "label": "카드뉴스 미리보기", "provider": "human", "dependsOn": ["carousel_render"], "outputs": ["approved_carousel"], "humanGate": false, "description": "슬라이드 순서·문구·시각화를 확인하고 발행을 확정합니다." },
    { "id": "carousel_publish", "order": 10, "phase": "carousel", "label": "Instagram 카드뉴스 발행", "provider": "instagram", "dependsOn": ["carousel_approve"], "outputs": ["carousel_publish_receipt"], "humanGate": false, "description": "Meta Content Publishing API로 예약 발행합니다." },
    { "id": "threads_draft", "order": 11, "phase": "threads", "label": "Threads 3개 생성", "provider": "openai", "dependsOn": ["atom_extract"], "outputs": ["THREADS_PACKAGE.md"], "humanGate": true, "description": "단문 2개와 연속형 1개를 서로 다른 관점으로 생성합니다." },
    { "id": "threads_approve", "order": 12, "phase": "threads", "label": "Threads 문구 확정", "provider": "human", "dependsOn": ["threads_draft"], "outputs": ["approved_threads"], "humanGate": false, "description": "사실·말투·중복을 확인하고 개별 발행 여부를 결정합니다." },
    { "id": "threads_publish", "order": 13, "phase": "threads", "label": "Threads 예약 발행", "provider": "threads", "dependsOn": ["threads_approve"], "outputs": ["threads_publish_receipts"], "humanGate": false, "description": "Threads API로 정해진 날짜에 순차 발행합니다." },
    { "id": "multichannel_metrics", "order": 14, "phase": "learning", "label": "채널별 성과 수집", "provider": "metrics_worker", "dependsOn": ["shorts_publish", "carousel_publish", "threads_publish"], "outputs": ["METRICS_SNAPSHOTS.json"], "humanGate": false, "description": "1h·24h·7d·30d 성과를 Atom·훅 단위로 수집합니다." },
    { "id": "multichannel_learn", "order": 15, "phase": "learning", "label": "성과 학습 반영", "provider": "openai", "dependsOn": ["multichannel_metrics"], "outputs": ["REPURPOSING_LEARNING.md"], "humanGate": false, "description": "채널별 성공 훅·구조·CTA를 다음 Content DNA 생성 Context에 반영합니다." }
  ]
}
