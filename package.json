{
  "name": "brandyaction-os",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "setup:local": "node tools/setup-local.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run env:check -- --mode local --file .env.example && npm run lint && npm run typecheck && npm test && npm run build",
    "env:check": "node tools/check-environment.mjs",
    "telegram:webhook:register": "node tools/register-telegram-webhook.mjs",
    "import:knowledge": "node tools/import-knowledge.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
