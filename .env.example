# Runtime configuration; keep deployment-specific values in the secure environment.
# Allowed values: local, development, qa, production.
OS_ENVIRONMENT=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OS_INITIAL_PASSWORD=

# Search and answer generation
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_TOKEN_ENCRYPTION_KEY=
YOUTUBE_OAUTH_REDIRECT_URI=
CLAUDE_HAIKU_MODEL=
CLAUDE_SONNET_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_ANSWER_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
OPENAI_VISION_MODEL=
CRON_SECRET=

# Optional Telegram webhook
OS_PUBLIC_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_BOT_USERNAME=
# Required for Telegram capture storage; use the active owner's email in the secure environment.
TELEGRAM_CAPTURE_OWNER_EMAIL=

# Read-only advertising performance aggregation (credentials are server-only)
META_ADS_API_VERSION=
META_ADS_ACCESS_TOKEN=
META_ADS_MYIN_ACCOUNT_ID=
META_ADS_BRANDYEDU_ACCOUNT_ID=
GOOGLE_ADS_API_VERSION=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_MYIN_CUSTOMER_ID=
GOOGLE_ADS_BRANDYEDU_CUSTOMER_ID=

# UI preview only. Never keep true in DEV, QA, or Production.
NEXT_PUBLIC_DEMO_MODE=true

# Connected browser QA only. Use a dedicated DEV/QA test account; never Production credentials.
PLAYWRIGHT_BASE_URL=
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# Read-only System One DEV preflight. Default closed; no production enablement.
# Verify distinct DEV/Production identities outside Git before setting these.
# This endpoint refuses environments with external integration credentials.
SYSTEM_ONE_PREFLIGHT_ENABLED=false
# Server-owned DEV registry; leave unset until approved test references exist.
SYSTEM_ONE_REGISTRY_DOCUMENT_ID=
SYSTEM_ONE_REGISTRY_DOCUMENT_VERSION=
SYSTEM_ONE_DEV_SUPABASE_REF=
SYSTEM_ONE_PRODUCTION_SUPABASE_REF=
